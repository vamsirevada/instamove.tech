# Environment Variables Template
# Copy this file to .env.local and fill in your actual API keys

# TMDB API Key - Get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Recommendation limits (per client on Vercel, one shared bucket for local requests)
# RECOMMEND_RATE_LIMIT=8
# RECOMMEND_RATE_WINDOW_SECONDS=60

# Set both to share rate limits across deployment instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AI time budget before switching to TMDB. Set catalog only to test the fallback.
# RECOMMEND_AI_TIMEOUT_MS=4500
# RECOMMEND_CATALOG_ONLY=1
